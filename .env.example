# ==============================================================================
# Altkit Discord v4 — Environment Configuration Reference
# ==============================================================================
#
# SETUP
#   1. Copy this template without overwriting it:
#        cp .env.example .env
#
#   2. Fill in only the values required by the example you want to run.
#
#   3. Node.js does not load .env files automatically for ordinary scripts.
#      Altkit Discord requires Node.js 20.18+, so you can use Node's built-in loader:
#        node --env-file=.env examples/Basic.js
#
#      Alternatively, export variables in your shell before running an example:
#        export DISCORD_TOKEN='your-token'
#        node examples/Basic.js
#
# VALUE FORMAT
#   - Keep Discord IDs (snowflakes) as strings of digits.
#   - Values normally do not need quotes in this file.
#   - Use quotes if a value contains spaces or a # character.
#   - URL-encode special characters in proxy usernames and passwords.
#   - Do not place comments after a value; use a separate comment line.
#
# SECURITY — READ BEFORE CONTINUING
#   - Never commit .env or paste its contents into issues, logs, or screenshots.
#   - Never put a real token or TOTP secret in this example template.
#   - A Discord user token grants full access to the account. Rotate it immediately
#     if it is exposed.
#   - Automating a user account violates Discord's Terms of Service and can result
#     in account termination. Altkit Discord is unofficial and used at your own risk.
#
# Required by: every runnable example
# ==============================================================================

# Discord user-account token.
# Example shape only: abcdefghijklmnopqrstuvwxyz.123456.abcdefghijklmnopqrstuvwxyz
DISCORD_TOKEN=


# ==============================================================================
# Discord Resource IDs
# ==============================================================================
#
# Enable Discord Developer Mode, then right-click a resource and choose "Copy ID".
# Only populate the IDs needed by the selected example.

# Text-based channel used to send activities, polls, embeds, or voice messages.
# Required by:
#   - examples/ActivityMessage.js
#   - examples/CreateAndVotePoll.js
#   - examples/VoiceMessage.js
CHANNEL_ID=

# Voice channel used by every example under examples/VoiceChannel/.
VOICE_CHANNEL_ID=

# Guild/server that receives an authorized application or bot installation.
# Required by: examples/AddBot.js
GUILD_ID=

# Discord application ID used for authorization or user-app installation.
# Required by:
#   - examples/AddBot.js
#   - examples/AuthorizeUserApps.js
APPLICATION_ID=


# ==============================================================================
# Invite and Account Verification
# ==============================================================================

# Invite code only—not the complete URL.
# Accepted: abcDEF123
# Avoid:    https://discord.gg/abcDEF123
# Required by: examples/JoinGuild.js
INVITE_CODE=

# Base32 TOTP secret for accounts with authenticator-based 2FA.
# Optional; used only when Discord requests TOTP during examples/AddBot.js.
# Treat this with the same sensitivity as the account password and token.
TOTP_SECRET=


# ==============================================================================
# Network / Proxy Configuration
# ==============================================================================

# Optional HTTP(S) proxy URL for Discord REST API requests.
# Used by: examples/Proxy.js
#
# Supported shapes:
#   http://127.0.0.1:8080
#   http://username:password@proxy.example.com:8080
#   https://proxy.example.com:8443
#
# Leave empty to connect directly.
HTTP_PROXY=


# ==============================================================================
# Example Requirement Matrix
# ==============================================================================
#
#   Basic.js                         DISCORD_TOKEN
#   ActivityMessage.js               DISCORD_TOKEN, CHANNEL_ID
#   CreateAndVotePoll.js             DISCORD_TOKEN, CHANNEL_ID
#   VoiceMessage.js                  DISCORD_TOKEN, CHANNEL_ID
#   Embed.js                         DISCORD_TOKEN
#   RichPresence.js                  DISCORD_TOKEN
#   SamsungRPC.js                    DISCORD_TOKEN
#   JoinGuild.js                     DISCORD_TOKEN, INVITE_CODE
#   AuthorizeUserApps.js             DISCORD_TOKEN, APPLICATION_ID
#   AddBot.js                        DISCORD_TOKEN, APPLICATION_ID, GUILD_ID
#                                    Optional: TOTP_SECRET
#   Proxy.js                         DISCORD_TOKEN
#                                    Optional: HTTP_PROXY
#   VoiceChannel/*.js                DISCORD_TOKEN, VOICE_CHANNEL_ID
#
# Some examples also require files, codecs, native packages, media devices, or
# external applications. Read examples/README.md and each example's header first.
# ==============================================================================
